<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dmy.ygagentserver.module.user.repository.LocationRepository">

    <select id="findLocationsByCampusId"
            resultType="com.dmy.ygagentserver.module.user.entity.Location">
        SELECT *
        FROM location
        WHERE campus_id = #{campusId}
          AND status = 1
        ORDER BY sort ASC
    </select>

</mapper>
