<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dmy.ygagentserver.module.repository.AuthRepository">

    <select id="findByTypeAndAccount"
            resultType="com.dmy.ygagentserver.module.entity.Auth">

        SELECT *
        FROM auth
        WHERE  phone = #{account}

    </select>

</mapper>
