<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dmy.ygagentserver.module.repository.UserRepository">

    <select id="findById"
            resultType="com.dmy.ygagentserver.module.entity.User">
        SELECT *
        FROM user_profile
        WHERE user_id = #{userId}

    </select>

</mapper>
